/*
Objective:
Analyze total units currently on order by product category.

Skills implemented:
- JOINs
- Aggregations (SUM)
- CTE for structured query design
*/

WITH UnitsOnOrderByCategory AS (
    SELECT
        c.CategoryName AS Category,
        SUM(p.UnitsOnOrder) AS TotalUnitsOnOrder
    FROM Categories c
    JOIN Products p ON p.CategoryID = c.CategoryID
    GROUP BY c.CategoryName
)
SELECT
    Category,
    TotalUnitsOnOrder
FROM UnitsOnOrderByCategory
ORDER BY Category;
